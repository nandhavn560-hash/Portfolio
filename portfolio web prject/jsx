// src/components/VideoPlayer.js
import React from 'react';

function VideoPlayer({ videoUrl, title, description }) {
  return (
    <div>
      <video controls width="700" height="400" src={videoUrl}>
        Your browser does not support the video tag.
      </video>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
  );
}

export default VideoPlayer;

// src/pages/VideoPage.js
import React, { useState, useEffect } from 'react';
import VideoPlayer from '../components/VideoPlayer';
import api from '../services/api'; // Your API service

function VideoPage({ videoId }) {
  const [videoData, setVideoData] = useState(null);

  useEffect(() => {
    api.fetchVideo(videoId)
      .then(data => setVideoData(data))
      .catch(error => console.error("Error fetching video:", error));
  }, [videoId]);

  if (!videoData) {
    return <div>Loading...</div>;
  }

  return (
    <div>
      <VideoPlayer videoUrl={videoData.url} title={videoData.title} description={videoData.description} />
      {/* Add comments section here */}
    </div>
  );
}

export default VideoPage;